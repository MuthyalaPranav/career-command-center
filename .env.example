# Backend process settings. Apply these in the backend environment.
RESUME_ENV=development
FRONTEND_ORIGINS=http://localhost:5173
# Required in production. Point to an existing absolute path on a private persistent volume.
RESUME_DATA_DIR=
# Minimum confirmed coverage percentage for reuse recommendations.
RESUME_REUSE_THRESHOLD=80
# Required in production. Generate with secrets.token_urlsafe(32).
RESUME_WORKSPACE_TOKEN=
# Required in production. Keep this in the backend environment or host secret store.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Frontend build settings. Set an HTTPS API URL for deployment.
VITE_API_BASE_URL=http://127.0.0.1:8000
